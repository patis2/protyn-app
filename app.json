{
  "expo": {
    "name": "Protyn",
    "slug": "protyn",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.protyn"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#2F5240"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.protyn"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Protyn",
      "themeColor": "#2F5240",
      "backgroundColor": "#F8F1E9"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      "expo-secure-store"
    ],
    "scheme": "protyn",
    "experiments": {
      "typedRoutes": false
    }
  }
}
